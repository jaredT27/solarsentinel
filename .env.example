# ─── Solar Sentinel Enhanced — Secrets ────────────────────────
# Copy this file to .env and fill in your values.
# All other settings are in config.yaml.

# Telegram Bot API token (get from @BotFather on Telegram)
TELEGRAM_TOKEN=your_bot_token_here

# Google Static Maps API key (optional but recommended)
# If set: alerts include embedded satellite images with red pin markers.
# If blank: alerts include a clickable Google Earth link instead.
GOOGLE_MAPS_API_KEY=

# PJM Data Miner API key (required for NJ + OH queue data)
# Register free at https://dataminer2.pjm.com/
PJM_API_KEY=

# Gmail SMTP credentials (for Weekly Email Digest add-on)
# Use a Gmail App Password, NOT your regular password.
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
